{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kibo",
  "version": "1.2.1",
  "identifier": "dev.kibo.desktop",
  "build": { "frontendDist": "../../../packages/ui/dist" },
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/kibo-daemon", "binaries/kibo-hook"],
    "resources": {
      "../../../packages/ui/dist/": "ui/",
      "toolchain/": "toolchain/",
