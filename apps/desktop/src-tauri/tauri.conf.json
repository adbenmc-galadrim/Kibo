{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kibo",
  "version": "0.19.0-alpha.1",
  "identifier": "dev.kibo.desktop",
  "build": { "frontendDist": "../../../packages/ui/dist" },
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage"],
    "shortDescription": "Centre de contrôle local pour tes projets de code",
    "longDescription": "Kibo organise tes projets de code en pages et composants : Kanban, tickets, graphe, notes.\nIl lance Claude Code en local sur tes tickets, sans jamais quitter ta machine.\nLocal-first : tes données restent dans ~/.kibo.",
    "category": "DeveloperTool",
    "copyright": "© 2026 Adam Ben Mchichi",
    "publisher": "Kibo",
    "homepage": "https://github.com/adbenmc-galadrim/Kibo",
    "license": "MIT",
    "externalBin": ["binaries/kibo-daemon", "binaries/kibo-hook", "binaries/kibo-demo-agent"],
    "resources": {
      "../../../packages/ui/dist/": "ui/",
      "toolchain/": "toolchain/",
      "builtin/": "builtin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["bubblewrap"], "desktopTemplate": "linux/kibo.desktop.hbs" },
      "rpm": { "depends": ["bubblewrap"] }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "../dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzM0I5NUM2RkFBODUxMDAKUldRQVVhajZ4cFU3WTJJLzRoOWNETDlSTWkySnNpVzV1Uml5dW0ydGNMT1RjTXpUUG40b1VsQlUK",
      "endpoints": [
        "https://github.com/adbenmc-galadrim/Kibo/releases/download/alpha/latest.json",
        "https://github.com/adbenmc-galadrim/Kibo/releases/latest/download/latest.json"
      ]
    }
  }
}
