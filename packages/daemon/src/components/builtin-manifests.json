  {
    "id": "notes",
    "version": "1.0.0",
    "kind": "both",
    "formats": ["medium", "large", "half", "full"],
    "size": {
      "min": {
        "w": 4,
        "h": 3
      }
    },
    "title": "Notes",
    "description": "Markdown local, compatible Obsidian",
    "reads": ["note", "ticket", "status"],
