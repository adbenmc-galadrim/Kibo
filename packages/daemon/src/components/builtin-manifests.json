    "size": {
      "min": {
        "w": 6,
        "h": 4
      }
    },
    "title": "Kanban",
    "description": "Tickets par statut, glisser-déposer",
    "reads": ["ticket", "status", "run", "ci_run"],
    "selection": true,
    "writes": ["ticket"],
    "data": true,
    "configSchema": {
      "filter": {
        "enum": ["mine-and-agents", "all"],
        "default": "mine-and-agents"
      }
    }
  },
  {
    "id": "tickets",
    "version": "1.0.0",
    "kind": "both",
    "formats": ["medium", "large", "half", "full"],
    "size": {
      "min": {
        "w": 4,
        "h": 3
      }
    },
    "title": "Tickets",
    "description": "Arbre des tickets, sous-tickets illimités",
    "reads": ["ticket", "status", "run"],
    "selection": true,
    "writes": ["ticket"],
    "configSchema": {
      "filter": {
        "enum": ["all", "mine"],
        "default": "all"
      }
    }
  },
  {
    "id": "graph",
    "version": "1.0.0",
