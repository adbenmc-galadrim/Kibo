    "configSchema": {
      "path": {
        "type": "string",
        "nullable": true,
        "default": null
      }
    }
  },
  {
    "id": "mcp-source",
    "version": "1.0.0",
    "kind": "widget",
    "formats": ["small", "medium", "large", "half"],
    "size": {
      "min": {
        "w": 3,
        "h": 2
      }
    },
    "title": "Source MCP",
    "description": "Liste des éléments d'un serveur MCP, un ticket par élément sur demande",
    "reads": ["ticket"],
    "writes": ["ticket"],
    "data": true,
    "mcp": ["{config.server}"],
    "configSchema": {
      "title": {
        "type": "string",
        "default": "Source MCP"
      },
      "server": {
        "type": "string"
      },
      "mode": {
        "enum": ["tool", "resource"],
        "default": "tool"
      },
      "tool": {
        "type": "string"
      },
      "uri": {
        "type": "string"
      },
      "args": {
        "type": "string",
        "default": "{}"
      },
      "refreshMinutes": {
        "type": "number",
        "default": 15
      },
      "itemsPointer": {
        "type": "string",
        "default": "/items"
      },
      "idPointer": {
        "type": "string",
        "default": "/id"
      },
      "titlePointer": {
        "type": "string",
        "default": "/name"
      },
      "subtitlePointer": {
        "type": "string"
      },
      "urlPointer": {
        "type": "string"
      }
    }
  },
  {
    "id": "viewer-3d",
    "version": "1.0.0",
    "kind": "both",
    "formats": ["medium", "large", "half", "full"],
    "size": {
      "min": {
        "w": 3,
        "h": 3
      }
    },
    "title": "Visionneuse 3D",
    "description": "Affiche un modèle .glb du projet",
    "reads": [],
    "writes": [],
    "capabilities": ["webgl", "assets"],
    "configSchema": {
      "model": {
        "type": "string",
        "nullable": true,
        "default": null,
        "asset": "model",
        "label": "Modèle (.glb)"
      },
      "autoRotate": {
        "type": "boolean",
        "default": true,
        "label": "Rotation automatique"
      },
      "lighting": {
        "type": "string",
        "enum": ["soft", "studio", "contrast"],
        "default": "soft",
        "label": "Éclairage"
      },
      "lightIntensity": {
        "type": "number",
        "min": 0.25,
        "max": 2,
        "default": 1,
        "label": "Intensité"
      },
      "shadows": {
        "type": "boolean",
        "default": false,
        "label": "Ombres"
      },
      "environment": {
        "type": "boolean",
        "default": true,
        "label": "Lumière d'ambiance",
        "help": "Reflets doux d'un studio neutre."
      }
    }
  },
