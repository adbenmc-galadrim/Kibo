    "kind": "adapter",
    "title": "GitHub Issues",
    "description": "Synchronise les tickets avec les issues et un Project GitHub",
    "reads": ["ticket", "status"],
    "writes": [],
    "net": ["api.github.com"],
    "secrets": [
      {
        "name": "github",
        "hosts": ["api.github.com"]
      }
    ]
  },
  {
    "id": "questions",
    "version": "1.0.0",
    "kind": "both",
    "formats": ["medium", "large", "half", "full"],
    "size": { "min": { "w": 4, "h": 3 } },
