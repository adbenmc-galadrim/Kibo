{
  "state": "~/.delivery",
  "projects": {
    "atlas": {
      "root": "~/Documents/atlas",
      "repo": "~/Documents/atlas/atlas",
      "remote": "acme/atlas",
      "base": "staging",
      "profile": "~/Documents/atlas/delivery-profile.md",
      "memory": "~/.claude/projects/-home-dev-Documents-atlas/memory/MEMORY.md",
      "plan": {
        "format": "plan-data-js",
        "path": "~/Documents/atlas/tmp/plan-data.js",
        "prose": "~/Documents/atlas/tmp/plan-prs-*.md",
        "idPattern": "^C[0-9A-Z]*-[0-9]+$"
      },
      "briefs": "~/Documents/atlas/tmp/briefs",
      "reports": "~/Documents/atlas/tmp/reports",
      "progress": "~/Documents/atlas/.progress",
      "todo": "~/Documents/atlas/TODO.md",
      "board": { "port": 4848 },
      "worktree": {
        "dir": "~/Documents/atlas/atlas-{slug}",
        "copyFrom": ["~/Documents/atlas/atlas-staging", "{repo}"],
        "copy": [".galacryptkey", "apps/backend/.env", "apps/backend/.env.test", "apps/frontend/.env"],
        "after": ["~/Documents/atlas/bin/atlas-sweep --reap --keep {slug} --yes", "make pr-up"]
      }
    },
    "nimbus": {
      "root": "~/Documents/nimbus",
      "repo": "~/Documents/nimbus/nimbus",
      "remote": "acme/nimbus",
      "base": "main",
      "profile": "~/Documents/nimbus/delivery-profile.md",
      "memory": "~/.claude/projects/-home-dev-Documents-nimbus/memory/MEMORY.md",
      "plan": {
        "format": "plan-data-js",
        "path": "~/Documents/nimbus/tmp/plan-data.js",
        "idPattern": "^(W[0-9A-Z]+|R[0-9]+|N[0-9]+|E|F)$"
      },
      "briefs": "~/Documents/nimbus/tmp/briefs",
      "reports": "~/Documents/nimbus/tmp/reports",
      "progress": "~/Documents/nimbus/.progress",
      "todo": "~/Documents/nimbus/TODO.md",
      "worktree": {
        "dir": "~/Documents/nimbus/nimbus-{slug}",
        "copyFrom": ["{repo}"],
        "copy": [".env", ".galacryptkey"],
        "env": {
          "file": ".env",
          "ports": {
            "keys": { "BACKEND_PORT": 3300, "METRO_PORT": 8000 },
            "from": 40,
            "step": 1,
            "count": 59
          },
          "replace": { "DATABASE_URL": ["/[^/?]+(\\?|$)", "/nimbus_{slug_}$1"] },
          "set": {
            "DATABASE_NAME": "nimbus_{slug_}",
            "BETTER_AUTH_URL": "http://localhost:{BACKEND_PORT}",
            "EXPO_PUBLIC_BACKEND_URL": "http://localhost:{BACKEND_PORT}"
          }
        },
        "after": [
          "docker exec nimbus-postgres createdb -U postgres nimbus_{slug_} 2>/dev/null || true",
          "pnpm install",
          "pnpm db:migrate"
        ]
      }
    },
    "silo": {
      "root": "~/Documents/silo",
      "repo": "~/Documents/silo/silo",
      "remote": "silo-labs/silo-location",
      "base": "dev",
      "profile": "~/Documents/silo/delivery-profile.md",
      "memory": "~/.claude/projects/-Users-galadrim-Documents-silo/memory/MEMORY.md",
      "plan": {
        "format": "kibo",
        "project": "SILO",
        "detail": "~/Documents/silo/archive-2026-10-08/plan-data.js",
        "idPattern": "^C[0-9A-Z]*-[0-9]+$"
      },
      "briefs": "~/Documents/silo/kibo-notes/briefs",
      "reports": "~/Documents/silo/kibo-notes/revues",
      "progress": "~/Documents/silo/.progress",
      "todo": "~/Documents/silo/TODO.md",
      "board": { "port": 4858 },
      "worktree": {
        "dir": "~/Documents/silo/silo-{dashed}",
        "copyFrom": ["{repo}", "{sibling}"],
        "copy": [".env"],
        "env": {
          "file": ".env",
          "ports": { "keys": { "WEB_PORT": 3000, "SERVER_PORT": 3001 }, "from": 1, "step": 10, "count": 32 }
        },
        "after": ["pnpm install"]
      }
    }
  }
}
