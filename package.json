{
  "name": "kibo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "components/*",
    "apps/*",
    "e2e",
    "scripts/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "start": "bun run --cwd packages/ui build && bun packages/daemon/src/main.ts --ui packages/ui/dist",
    "typecheck": "tsc -b packages/schema packages/trust packages/core packages/sync-server packages/devkit packages/daemon packages/sdk packages/cli packages/ui packages/ui/scripts components/tickets components/kanban components/graph components/notes components/github-issues components/mcp-source components/viewer-3d e2e scripts/dogfood apps/desktop",
    "test": "bun test packages components ./scripts",
    "budget": "bun packages/ui/scripts/bundle-budget.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@happy-dom/global-registrator": "18.0.1",
    "@kibo/devkit": "workspace:*",
    "@kibo/sdk": "workspace:*",
    "@tailwindcss/node": "4.1.13",
    "@tailwindcss/oxide": "4.1.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.1.13",
    "@types/three": "0.186.0",
    "lucide-react": "1.48.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.1.13",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@types/node": "26.6.2"
  }
}
