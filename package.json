{
  "name": "kibo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "components/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "start": "bun run --cwd packages/ui build && bun packages/daemon/src/main.ts --ui packages/ui/dist",
    "typecheck": "tsc -b packages/schema packages/core packages/daemon packages/sdk packages/ui components/tickets components/kanban e2e apps/desktop",
    "test": "bun test packages components"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@happy-dom/global-registrator": "18.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.4.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@types/node": "26.6.2"
  }
}
